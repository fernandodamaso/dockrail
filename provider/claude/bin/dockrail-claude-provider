#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Demand-driven Dockrail-owned Claude Desktop session provider.

Started only while a Dockrail consumer is active. Polls the per-session
records written by ``dockrail claude hook`` (Claude Code hooks), keeps the
sessions Claude Desktop started, and emits versioned normalized JSON lines in
the Herdr provider contract (schema v1).
"""
from __future__ import annotations

import argparse
import json
import os
import queue
import select
import signal
import sys
import threading
import time
import uuid
from pathlib import Path
from typing import Any

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(ROOT))

import claudestate  # noqa: E402

POLL_EVERY = 0.5
SAFETY_EMIT_EVERY = 60.0
OUTPUT_TIMEOUT = 2.0
MAX_STDIN_LINE = 4096

ACTION_ERRORS = (
    "invalid_request",
    "inventory_reconciling",
    "agent_gone",
    "identity_mismatch",
    "server_unavailable",
    "timeout",
    "provider_unavailable",
    "unsupported",
    "unsupported_command",
)


def parse_window_processes_command(raw: bytes) -> dict[str, Any] | None:
    """Parse a bounded window-processes stdin command (Herdr contract)."""
    if len(raw) > MAX_STDIN_LINE:
        return None
    try:
        message = json.loads(raw)
    except (ValueError, UnicodeError, RecursionError):
        return None
    if not isinstance(message, dict) or set(message) - {"kind", "revision", "pids"}:
        return None
    if message.get("kind") != "window-processes":
        return None
    revision = message.get("revision")
    if not isinstance(revision, int) or isinstance(revision, bool) or revision < 0:
        return None
    pids = message.get("pids")
    if not isinstance(pids, list):
        return None
    normalized: list[int] = []
    for value in pids:
        if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
            return None
        if value not in normalized:
            normalized.append(value)
    if len(normalized) > claudestate.MAX_WINDOW_PIDS:
        return None
    return {"revision": revision, "pids": normalized}


def bounded(value: object, maximum: int) -> str | None:
    """Return ``value`` when it is a bounded, control-free, encodable string."""
    if not isinstance(value, str) or not value or len(value) > maximum:
        return None
    if any(
        ord(char) < 32 or ord(char) == 127 or 0xD800 <= ord(char) <= 0xDFFF
        for char in value
    ):
        return None
    return value


def parse_focus_agent_command(raw: bytes) -> dict[str, Any] | None:
    """Parse a focus-agent stdin command (exact Herdr key set)."""
    if not isinstance(raw, (bytes, bytearray)) or len(raw) > MAX_STDIN_LINE:
        return None
    try:
        message = json.loads(raw)
    except (ValueError, UnicodeError, TypeError, RecursionError):
        return None
    if not isinstance(message, dict):
        return None
    allowed = {
        "kind",
        "requestId",
        "providerEpoch",
        "serverId",
        "connectionGeneration",
        "agentId",
        "paneId",
        "terminalId",
    }
    if set(message) - allowed:
        return None
    if message.get("kind") != "focus-agent":
        return None

    request_id = bounded(message.get("requestId"), 64)
    epoch = bounded(message.get("providerEpoch"), 64)
    server_id = bounded(message.get("serverId"), 128)
    # Agent ids embed server, generation and pane id; 512 leaves headroom.
    agent_id = bounded(message.get("agentId"), 512)
    pane_id = bounded(message.get("paneId"), 512)
    if not request_id or not epoch or not server_id or not agent_id or not pane_id:
        return None
    generation = message.get("connectionGeneration")
    if isinstance(generation, bool):
        return None
    if isinstance(generation, float):
        if not generation.is_integer() or generation <= 0:
            return None
        generation = int(generation)
    elif not isinstance(generation, int) or generation <= 0:
        return None
    terminal_raw = message.get("terminalId", "")
    if terminal_raw in ("", None):
        terminal = ""
    else:
        terminal = bounded(terminal_raw, 128)
        if terminal is None:
            return None
    return {
        "requestId": request_id,
        "providerEpoch": epoch,
        "serverId": server_id,
        "connectionGeneration": generation,
        "agentId": agent_id,
        "paneId": pane_id,
        "terminalId": terminal,
    }


class Provider:
    def __init__(
        self, state_dirs: list[Path], proc_root: Path, desktop_dirs: list[Path]
    ) -> None:
        self.state_dirs = state_dirs
        self.proc_root = proc_root
        self.desktop_dirs = desktop_dirs
        self.events: queue.Queue[tuple[str, Any]] = queue.Queue()
        self.epoch = uuid.uuid4().hex
        self.revision = 0
        self.stopping = False
        self.last_emit = 0.0
        self.last_fingerprint = ""
        self.last_agents: list[dict[str, Any]] = []
        self.wp_revision = 0
        self.wp_identities: list[dict[str, int]] = []

    def _stdin(self) -> None:
        for raw in sys.stdin.buffer:
            command = raw.strip()
            if len(command) > MAX_STDIN_LINE:
                continue
            if command in (b"refresh", b"quit"):
                self.events.put(("command", command.decode("ascii")))
                if command == b"quit":
                    return
                continue
            parsed = parse_window_processes_command(command)
            if parsed is not None:
                self.events.put(("window-processes", parsed))
                continue
            focus = parse_focus_agent_command(command)
            if focus is not None:
                self.events.put(("focus-agent", focus))
                continue
            try:
                message = json.loads(command)
            except (ValueError, UnicodeError, RecursionError):
                continue
            if isinstance(message, dict) and message.get("kind") == "focus-agent":
                # Echo only a requestId the focus-agent contract would accept.
                request_id = bounded(message.get("requestId"), 64)
                if request_id:
                    self.events.put(
                        ("action-result", {"requestId": request_id, "error": "invalid_request"})
                    )
            # Unknown commands are ignored: the dock only drives agents through
            # the focus-agent contract, never through a generic command channel.
        self.events.put(("command", "quit"))

    def build(self) -> dict[str, Any]:
        now_ms = int(time.time() * 1000)
        records = claudestate.read_records(self.state_dirs)
        desktop = claudestate.desktop_sessions(self.desktop_dirs)
        sessions, clients = claudestate.collect_sessions(
            records, self.proc_root, now_ms, desktop
        )
        state = claudestate.BuildState(
            epoch=self.epoch,
            revision=self.revision + 1,
            wp_revision=self.wp_revision,
            wp_identities=list(self.wp_identities),
            now_ms=now_ms,
        )
        return claudestate.build_snapshot(state, sessions, clients)

    def write_frame(self, payload: dict[str, Any], ensure_ascii: bool = False) -> None:
        frame = (
            json.dumps(payload, separators=(",", ":"), ensure_ascii=ensure_ascii) + "\n"
        ).encode()
        view = memoryview(frame)
        deadline = time.monotonic() + OUTPUT_TIMEOUT
        while view:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([], [sys.stdout], [], remaining)[1]:
                raise BrokenPipeError("provider output unavailable")
            written = os.write(sys.stdout.fileno(), view[:65536])
            if written <= 0:
                raise BrokenPipeError("provider output unavailable")
            view = view[written:]

    def emit(self, force: bool = False) -> None:
        snapshot = self.build()
        fingerprint = claudestate.snapshot_fingerprint(snapshot)
        if not force and fingerprint == self.last_fingerprint:
            return
        self.revision += 1
        snapshot["revision"] = self.revision
        self.write_frame(snapshot)
        self.last_fingerprint = fingerprint
        self.last_emit = time.monotonic()
        self.last_agents = snapshot["agents"]

    # -- focus-agent -------------------------------------------------------
    def emit_action_result(self, request_id: str, ok: bool, error: str = "") -> None:
        code = error if isinstance(error, str) and error else ""
        if ok:
            code = ""
        elif code not in ACTION_ERRORS:
            code = "unsupported"
        # ASCII-only so an odd requestId can never fail to encode and kill the provider.
        self.write_frame({
            "kind": "action-result",
            "requestId": request_id,
            "ok": ok is True,
            "error": code,
        }, ensure_ascii=True)

    def apply_focus_agent(self, request: dict[str, Any]) -> None:
        """Acknowledge a focus request; the dock raises the window itself."""
        request_id = str(request.get("requestId") or "")
        if not request_id:
            return
        if request.get("providerEpoch") != self.epoch:
            self.emit_action_result(request_id, False, "identity_mismatch")
            return
        if request.get("serverId") != claudestate.SERVER_ID:
            self.emit_action_result(request_id, False, "server_unavailable")
            return
        if request.get("connectionGeneration") != 1:
            self.emit_action_result(request_id, False, "identity_mismatch")
            return
        agent_id = request["agentId"]
        pane_id = request["paneId"]
        match = any(
            agent.get("id") == agent_id and agent.get("paneId") == pane_id
            for agent in self.last_agents
        )
        if not match:
            self.emit_action_result(request_id, False, "agent_gone")
            return
        self.emit_action_result(request_id, True)

    def apply(self, event: tuple[str, Any]) -> bool:
        """Apply one event; return True when the next emit must be forced."""
        kind, payload = event
        if kind == "command" and payload == "quit":
            self.stopping = True
            return False
        if kind == "command" and payload == "refresh":
            return True
        if kind == "window-processes":
            self.wp_revision = payload["revision"]
            self.wp_identities = claudestate.resolve_window_identities(
                payload["pids"], self.proc_root
            )
            return True
        if kind == "focus-agent":
            self.apply_focus_agent(payload)
            return False
        if kind == "action-result":
            self.emit_action_result(payload["requestId"], False, payload["error"])
            return False
        return False

    def run(self) -> None:
        threading.Thread(target=self._stdin, daemon=True).start()
        self.emit(force=True)
        next_poll = time.monotonic() + POLL_EVERY
        while not self.stopping:
            force = False
            timeout = max(0.0, next_poll - time.monotonic())
            try:
                force = self.apply(self.events.get(timeout=timeout))
                while True:
                    force = self.apply(self.events.get_nowait()) or force
            except queue.Empty:
                pass
            if self.stopping:
                break
            now = time.monotonic()
            if force or now >= next_poll:
                next_poll = now + POLL_EVERY
                self.emit(force=force or now - self.last_emit >= SAFETY_EMIT_EVERY)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state-dir", action="append", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--proc-root", default=None, help=argparse.SUPPRESS)
    args = parser.parse_args()
    dirs = [Path(d) for d in args.state_dir] if args.state_dir else claudestate.state_dirs()
    proc_root = Path(args.proc_root) if args.proc_root else Path("/proc")
    provider = Provider(dirs, proc_root, claudestate.desktop_session_dirs())

    def stop(_signum: int, _frame: object) -> None:
        provider.stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        provider.run()
    except (BrokenPipeError, KeyboardInterrupt):
        provider.stopping = True


if __name__ == "__main__":
    main()
