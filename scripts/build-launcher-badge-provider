#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_dir="$repo_root/provider/launcher-badges"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
build_dir="$cache_home/dockrail/launcher-badge-provider-build"
install_dir="$data_home/dockrail/providers"

for command in cmake ctest install; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "Required command not found: $command" >&2
    exit 1
  }
done

cmake -S "$source_dir" -B "$build_dir" \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_TESTING=ON
cmake --build "$build_dir" --parallel
ctest --test-dir "$build_dir" --output-on-failure
install -Dm0755 \
  "$build_dir/smartdock-launcher-badge-provider" \
  "$install_dir/smartdock-launcher-badge-provider"

cat <<EOF
Launcher badge provider installed:
  $install_dir/smartdock-launcher-badge-provider
EOF

cat <<'EOF'

Plugin-folder invocation:
  bash "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.fernandodamaso.dockrail/scripts/build-launcher-badge-provider"

Next: reload the dock with `omarchy restart shell`.
Then verify with `dockrail doctor`.
EOF
