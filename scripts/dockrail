#!/usr/bin/env bash
set -euo pipefail

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
app_dir="$data_home/dockrail"
legacy_app_dir="$data_home/smartdock"
client_dir="$data_home/dockrail-cli"
legacy_client_dir="$data_home/smartdock-cli"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_file="${DOCKRAIL_CONFIG:-${SMARTDOCK_CONFIG:-$config_home/dockrail/dock.json}}"
autostart_file="$config_home/autostart/smartdock.desktop"
launcher_path="$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"
plugin_adapter=""
if [[ -f "$client_dir/.plugin-dir" ]]; then
  plugin_dir="$(<"$client_dir/.plugin-dir")"
  if [[ ! -f "$plugin_dir/scripts/smartdock_cli.py" || ! -f "$plugin_dir/config/settings-schema.json" || ! -f "$plugin_dir/config/dock.json" || ! -f "$plugin_dir/docs/AGENT_CONFIGURATION.md" ]]; then
    message='Dockrail plugin files are missing. Reinstall with: omarchy plugin add https://github.com/fernandodamaso/dockrail.git --enable --yes; then run: bash ~/.config/omarchy/plugins/io.github.fernandodamaso.dockrail/install.sh --cli-only'
    for argument in "$@"; do
      if [[ "$argument" == --json ]]; then
        printf '%s\n' '{"apiVersion":1,"ok":false,"error":{"code":"E_TRANSPORT","message":"Dockrail plugin files are missing. Reinstall with: omarchy plugin add https://github.com/fernandodamaso/dockrail.git --enable --yes; then run: bash ~/.config/omarchy/plugins/io.github.fernandodamaso.dockrail/install.sh --cli-only"},"data":{},"warnings":[]}'
        exit 5
      fi
    done
    echo "dockrail: $message" >&2
    exit 5
  fi
  plugin_adapter="$plugin_dir/scripts/smartdock_cli.py"
fi

# Control commands, bare invocation and unknown words always go through the
# parser. Only explicit lifecycle words below can reach standalone startup.
case "${1:-}" in
  launch|--daemonize|-d|restart|--restart|stop|--stop|update|--update|uninstall|--uninstall|autostart) ;;
  *)
    for adapter in "$plugin_adapter" "$(dirname -- "$launcher_path")/smartdock_cli.py" \
      "$client_dir/scripts/smartdock_cli.py" "$app_dir/scripts/smartdock_cli.py" \
      "$legacy_client_dir/scripts/smartdock_cli.py" "$legacy_app_dir/scripts/smartdock_cli.py"; do
      if [[ -f "$adapter" ]]; then
        if command -v python3 >/dev/null 2>&1; then
          case "${1:-}" in
            dev)
              shift
              exec python3 -B "$(dirname -- "$adapter")/smartdock_dev.py" "$@"
              ;;
            widget)
              shift
              exec python3 -B "$(dirname -- "$adapter")/smartdock_widget.py" "$@"
              ;;
          esac
          exec python3 -B "$adapter" "$@"
        fi
        break
      fi
    done
    for argument in "$@"; do
      if [[ "$argument" == --json ]]; then
        printf '%s\n' '{"apiVersion":1,"ok":false,"error":{"code":"E_TRANSPORT","message":"CLI adapter or Python 3 unavailable; run install.sh --cli-only."},"data":{},"warnings":[]}'
        exit 5
      fi
    done
    echo 'dockrail: CLI adapter or Python 3 unavailable; run install.sh --cli-only.' >&2
    exit 5
    ;;
esac

# Standalone launches alone need the qs.* import mapping. Discovery and help
# must not create this cache or modify packaged Omarchy files.
ensure_omarchy_qml_imports() {
  local omarchy_shell="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
  [[ -d "$omarchy_shell/Commons" && -d "$omarchy_shell/Ui" ]] || return 0
  local import_root="${XDG_CACHE_HOME:-$HOME/.cache}/dockrail/qml-imports"
  install -d "$import_root"
  if [[ ! -e "$import_root/qs" ]]; then
    ln -s "$omarchy_shell" "$import_root/qs"
  fi
  export QML2_IMPORT_PATH="$import_root${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
}

enable_autostart() {
  install -d "$(dirname -- "$autostart_file")"
  cat >"$autostart_file" <<EOF
[Desktop Entry]
Type=Application
Name=Dockrail
Comment=Developer workspace rail for Hyprland
Exec="$launcher_path" --daemonize
OnlyShowIn=Hyprland;
X-GNOME-Autostart-enabled=true
EOF
  chmod 0644 "$autostart_file"
  echo "Autostart enabled: $autostart_file"
}

autostart() {
  case "${1:-status}" in
    enable) enable_autostart ;;
    disable) rm -f -- "$autostart_file"; echo 'Autostart disabled.' ;;
    status)
      if [[ -f "$autostart_file" ]]; then
        echo "Autostart is enabled: $autostart_file"
      else
        echo 'Autostart is disabled.'
      fi
      ;;
    help|--help|-h) echo 'Usage: dockrail autostart <enable|disable|status>' ;;
    *) echo "Unknown autostart action: $1" >&2; exit 2 ;;
  esac
}

case "${1:-}" in
  autostart)
    [[ $# -le 2 ]] || { echo 'Too many autostart arguments.' >&2; exit 2; }
    autostart "${2:-status}"
    exit
    ;;
  update|--update)
    [[ $# -eq 1 ]] || { echo 'Usage: dockrail update' >&2; exit 2; }
    source_file="$app_dir/.source-dir"
    if [[ ! -f "$source_file" && -f "$legacy_app_dir/.source-dir" ]]; then
      source_file="$legacy_app_dir/.source-dir"
    fi
    if [[ ! -f "$source_file" ]]; then
      echo "dockrail: standalone source checkout record not found at $source_file" >&2
      echo 'For a client-only update, run install.sh --cli-only from its source checkout.' >&2
      exit 1
    fi
    source_dir="$(<"$source_file")"
    installer="$source_dir/install.sh"
    [[ -f "$installer" ]] || { echo "dockrail: source installer not found at $installer" >&2; exit 1; }
    if [[ -f "$autostart_file" ]]; then
      bash "$installer"
    else
      bash "$installer" --no-autostart
    fi
    exit
    ;;
  stop|--stop)
    [[ $# -eq 1 ]] || { echo 'Usage: dockrail stop' >&2; exit 2; }
    qs kill -p "$app_dir" --any-display >/dev/null 2>&1 || true
    qs kill -p "$legacy_app_dir" --any-display >/dev/null 2>&1 || true
    exit
    ;;
  uninstall|--uninstall)
    shift
    if [[ "${1:-}" == --cli-only ]]; then
      if [[ -f "$client_dir/uninstall.sh" ]]; then
        exec bash "$client_dir/uninstall.sh" "$@"
      elif [[ -f "$legacy_client_dir/uninstall.sh" ]]; then
        exec bash "$legacy_client_dir/uninstall.sh" "$@"
      fi
    fi
    if [[ -f "$app_dir/uninstall.sh" ]]; then
      exec bash "$app_dir/uninstall.sh" "$@"
    elif [[ -f "$legacy_app_dir/uninstall.sh" ]]; then
      exec bash "$legacy_app_dir/uninstall.sh" "$@"
    fi
    echo 'Standalone uninstaller not found; run source uninstall.sh --cli-only for client-only removal.' >&2
    exit 1
    ;;
esac

selected_app_dir="$app_dir"
if [[ ! -f "$selected_app_dir/shell.qml" && -f "$legacy_app_dir/shell.qml" ]]; then
  selected_app_dir="$legacy_app_dir"
  if [[ -z "${DOCKRAIL_CONFIG:-}" && -z "${SMARTDOCK_CONFIG:-}" ]]; then
    config_file="$config_home/smartdock/dock.json"
  fi
fi
if [[ ! -f "$selected_app_dir/shell.qml" ]]; then
  echo 'dockrail: standalone application files not found; run the full installer explicitly' >&2
  exit 1
fi

case "$1" in
  restart|--restart)
    shift
    ensure_omarchy_qml_imports
    qs kill -p "$app_dir" --any-display >/dev/null 2>&1 || true
    qs kill -p "$legacy_app_dir" --any-display >/dev/null 2>&1 || true
    exec env DOCKRAIL_CONFIG="$config_file" SMARTDOCK_CONFIG="$config_file" qs -n -d -p "$selected_app_dir" "$@"
    ;;
  launch) shift ;;
esac
ensure_omarchy_qml_imports
exec env DOCKRAIL_CONFIG="$config_file" SMARTDOCK_CONFIG="$config_file" qs -n -p "$selected_app_dir" "$@"
