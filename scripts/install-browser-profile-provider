#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_file="$repo_root/provider/browser-profiles/browser_profile_provider.py"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
build_dir="$cache_home/dockrail/browser-profile-provider-build"
install_dir="$data_home/dockrail/providers"

for command in python3 install; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "Required command not found: $command" >&2
    exit 1
  }
done

install -d "$build_dir"
PYTHONPYCACHEPREFIX="$build_dir/pycache" python3 -m py_compile "$source_file"

install -Dm0755 "$source_file" \
  "$install_dir/smartdock-browser-profile-provider"

cat <<EOF
Browser profile provider installed:
  $install_dir/smartdock-browser-profile-provider

The provider needs Chrome running with an explicitly enabled DevTools endpoint.
See $repo_root/docs/browser-activity.md for Chrome setup and the security note.
EOF

cat <<'EOF'

Plugin-folder invocation:
  bash "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.fernandodamaso.dockrail/scripts/install-browser-profile-provider"

Next: reload the dock with `omarchy restart shell`.
Then verify with `dockrail doctor`.
EOF
