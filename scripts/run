#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Quickshell maps the `qs.*` imports used by Omarchy plugins to the config
# root. Standalone configs do not get that mapping from the Omarchy shell, so
# provide the same modules through a small user-cache alias when Omarchy is
# installed. The alias keeps the standalone entry point usable without
# copying or modifying files under /usr/share/omarchy.
omarchy_shell="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
if [[ -d "$omarchy_shell/Commons" && -d "$omarchy_shell/Ui" ]]; then
  import_root="${XDG_CACHE_HOME:-$HOME/.cache}/dockrail/qml-imports"
  mkdir -p "$import_root"
  # Retarget a stale or dangling alias after OMARCHY_PATH moves; never replace
  # a real directory.
  if [[ -L "$import_root/qs" || ! -e "$import_root/qs" ]] \
      && [[ "$(readlink -- "$import_root/qs" || true)" != "$omarchy_shell" ]]; then
    ln -sfn -- "$omarchy_shell" "$import_root/qs"
  fi
  export QML2_IMPORT_PATH="$import_root${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
fi

exec qs -p "$project_dir" "$@"
